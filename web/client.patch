diff --git a/src/main.ts b/src/main.ts
index 684d042..6026627 100644
--- a/src/main.ts
+++ b/src/main.ts
@@ -1,4 +1,15 @@
 import { createApp } from 'vue';
 import App from './App.vue';
 
+// Mobile keyboards resize the visual viewport independently of CSS vh/dvh.
+function fitVisibleViewport() {
+  const viewport = window.visualViewport;
+  if (viewport && viewport.scale !== 1) return; // Preserve pinch zoom.
+  document.documentElement.style.setProperty('--viewport-height', `${viewport?.height ?? window.innerHeight}px`);
+  document.documentElement.style.setProperty('--viewport-top', `${viewport?.offsetTop ?? 0}px`);
+}
+window.visualViewport?.addEventListener('resize', fitVisibleViewport);
+window.visualViewport?.addEventListener('scroll', fitVisibleViewport);
+window.addEventListener('resize', fitVisibleViewport);
+fitVisibleViewport();
 createApp(App).mount('#app');
