{
    admin off
    http_port 8080
    https_port 8443
}

fd.dreamiurg.net {
    import /etc/caddy/gate.caddy
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    reverse_proxy web:8080 {
        header_up -Authorization
    }
}
